CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json

# Must match the `aud` claim configured on the Clerk JWT template named
# "resource-management-api" (Clerk Dashboard -> Configure -> JWT Templates)
# that the frontend requests via getToken({ template: 'resource-management-api' }).
# Defaults to "resource-management-api" if unset — only override for a
# differently-named template.
# CLERK_AUDIENCE=resource-management-api

# local dev only — ignored in Docker Compose, which sets these itself
# (see docker-compose.yml) so the db lives in a named volume, not this path
DATABASE_MODE=sqlite
DATABASE_PATH=./local.db

# only needed once DATABASE_MODE=d1_http (i.e. hitting real Cloudflare D1)
# CF_ACCOUNT_ID=
# CF_D1_DATABASE_ID=
# CF_D1_API_TOKEN=
