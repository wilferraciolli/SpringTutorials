# Copy to .env for running insurly-api directly (IDE run config, mvn
# spring-boot:run) without docker-compose. Never commit the real .env.
# Loaded automatically via spring.config.import in application.yaml.

# DATABASE_* below use Supabase's pooled connection (Supavisor) — see
# docs/03-database-schema.md. Get the real host/username for your project
# from Supabase dashboard -> Project Settings -> Database -> Connection pooling.
# prepareThreshold=0 & preparedStatementCacheQueries=0 are REQUIRED against the
# transaction-mode pooler (:6543) — without them pgjdbc server-side prepared
# statements collide across pooled backends (Postgres error 42P05).
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?prepareThreshold=0&preparedStatementCacheQueries=0
DATABASE_USERNAME=postgres.<project-ref>
DATABASE_PASSWORD=changeme
CORS_ALLOWED_ORIGIN=http://localhost:4200
SERVER_PORT=5001

# Auth (Clerk). Required in every profile — there is no "local Clerk".
# AUTH_ISSUER_URI is Clerk's Frontend API URL for your application (Dashboard
# -> API Keys), e.g. https://<slug>.clerk.accounts.dev or a custom domain.
# AUTH_AUDIENCE / AUTH_ROLE_CLAIM must match the JWT Template named
# "insurly-api" configured in the Clerk dashboard (aud claim + a "roles"
# claim sourced from user.public_metadata.roles). See docs/05 §6.
AUTH_ISSUER_URI=https://<your-slug>.clerk.accounts.dev
AUTH_AUDIENCE=insurly-api
AUTH_ROLE_CLAIM=roles

# Server-to-server Clerk access for the POST /api/iam/webhooks/clerk endpoint,
# which assigns CLERK_DEFAULT_ROLE to public_metadata.roles on user.created
# (new users otherwise have no roles claim at all). CLERK_SECRET_KEY is the
# Secret key from Clerk Dashboard -> API Keys. CLERK_WEBHOOK_SIGNING_SECRET is
# the Signing Secret shown on the endpoint's page after you create it in
# Clerk Dashboard -> Webhooks (subscribe that endpoint to user.created only).
CLERK_SECRET_KEY=sk_test_changeme
CLERK_WEBHOOK_SIGNING_SECRET=whsec_changeme
CLERK_DEFAULT_ROLE=user

# Phase 2 accounts (see docs/05-security-and-accounts.md).
# Column-encryption key for user_license.license_number: base64 of exactly 32
# random bytes. Generate: `openssl rand -base64 32`. A built-in dev key is used
# if unset (a startup warning is logged) — set a real key in every real env.
LICENSE_ENC_KEY=

# OpenAPI / Swagger UI. On by default in the `local` profile; off by default in
# `prod` — set these to `true` there to expose the docs.
API_DOCS_ENABLED=false
SWAGGER_UI_ENABLED=false

# Email / notifications (see docs/07-notifications.md).
# EMAIL_ENABLED=false -> messages are rendered and logged, never sent.
# EMAIL_ENABLED=true  -> sent over SMTP (MAIL_* below); leave false unless
#                        MAIL_USERNAME + MAIL_PASSWORD are filled in.
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@insurly.example
EMAIL_FROM_NAME=insurly
APP_BASE_URL=http://localhost:4200
# Comma-separated recipients for the new-quote alert and the Monday digest.
EMAIL_ADMIN_RECIPIENTS=
EMAIL_WEEKLY_DIGEST_ENABLED=true
EMAIL_WEEKLY_DIGEST_CRON=0 0 8 * * MON
EMAIL_WEEKLY_DIGEST_ZONE=Europe/London

# SMTP transport, only used when EMAIL_ENABLED=true. Pick one:
#
# (a) LOCAL DEV — Mailtrap sandbox (recommended). Hosted catch-all inbox, mail
#     never reaches real recipients. Free tier: 100 emails/mo.
#       1. https://mailtrap.io -> Email Testing -> Inboxes -> <inbox> ->
#          Integrations -> SMTP
#       2. MAIL_HOST=sandbox.smtp.mailtrap.io  MAIL_PORT=2525
#       3. MAIL_USERNAME / MAIL_PASSWORD = the values shown there
#          MAIL_SMTP_AUTH=true  MAIL_SMTP_STARTTLS=true
#
# (b) REAL MAIL — any free SMTP provider. All are just different MAIL_* values:
#       SMTP2GO   mail.smtp2go.com:2525    1,000/mo free, verify a single
#                 sender address by email (no domain needed)
#       Mailjet   in-v3.mailjet.com:587    6,000/mo free (200/day)
#       Resend    smtp.resend.com:587      3,000/mo free, requires a verified
#                 domain; MAIL_USERNAME=resend, MAIL_PASSWORD=<API key>
#     For any of them: MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true, and the
#     EMAIL_FROM address/domain must be verified in the provider or mail bounces.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
